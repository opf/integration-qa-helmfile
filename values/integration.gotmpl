{{- $openprojectXwiki := .Values.openproject.xwiki | default dict -}}
{{- $mcp := dig "mcp" dict .Values -}}
{{- $adminPassword := .Values.adminPassword | default "admin" -}}
{{- $userPassword := .Values.userPassword | default "1234" -}}
{{- $standalone := .Values.openproject.standalone | default false -}}
{{- /* Missing keycloak.enabled → on for full stack, off for standalone; explicit true wins (op-keycloak). */ -}}
{{- $keycloakEnabled := dig "keycloak" "enabled" (not $standalone) .Values -}}
integrationSetupMethod: {{ .Values.integration.setupMethod }}
previewMode: {{ dig "previewMode" false .Values }}
adminPassword: {{ $adminPassword | quote }}
userPassword: {{ $userPassword | quote }}

mcp:
  enabled: {{ dig "enabled" true $mcp }}
  oauthToken: {{ dig "oauthToken" "" $mcp | quote }}

setupJob:
  enabled: true
  # Always defer: bootstrap must not race OP seeder; opnc-setup-job waits on openproject/nextcloud/keycloak.
  defer: true

openprojectHost: {{ .Values.openproject.host }}
openprojectAssetHost: {{ .Values.openproject.assetHost }}
nextcloudHost: {{ .Values.nextcloud.host }}
keycloakHost: {{ .Values.keycloak.host }}
xwikiHost: {{ .Values.xwiki.host }}
gitlabHost: {{ .Values.gitlab.host }}
squashtmHost: {{ .Values.squashtm.host }}

databases:
  - name: {{ .Values.openproject.postgresql.host | quote }}
    username: {{ .Values.openproject.postgresql.username | quote }}
    database: {{ printf "%s%s" .Values.openproject.postgresql.database (ternary "_dev" "" (eq .Values.openproject.railsEnv "development")) | quote }}
    password: {{ .Values.openproject.postgresql.password | quote }}
    size: 8Gi
    memoryRequest: 256Mi
    memoryLimit: 1Gi
  {{- if not $standalone }}
  - name: {{ .Values.nextcloud.postgresql.host | quote }}
    username: {{ .Values.nextcloud.postgresql.username | quote }}
    database: {{ .Values.nextcloud.postgresql.database | quote }}
    password: {{ .Values.nextcloud.postgresql.password | quote }}
    size: 8Gi
  {{- end }}
  {{- if $keycloakEnabled }}
  - name: {{ dig "postgresql" "host" "kc-postgresql" .Values.keycloak | quote }}
    username: keycloak
    database: keycloak
    password: {{ dig "postgresql" "password" "keycloak" .Values.keycloak | quote }}
    size: 8Gi
    memoryRequest: 256Mi
    memoryLimit: 1Gi
  {{- end }}
  {{- if .Values.gitlab.enabled }}
  - name: gitlab-postgresql
    username: gitlab
    database: gitlab
    password: {{ .Values.gitlab.postgresql.password | quote }}
    size: 8Gi
    memoryRequest: 512Mi
    memoryLimit: 2Gi
    # structure.sql loads in one transaction and locks every table/index/partition.
    args: ["-c", "max_locks_per_transaction=1024"]
    # GitLab schema load requires these; missing them makes migrations Job crash fast.
    extensions:
      - pg_trgm
      - btree_gist
      - amcheck
  {{- end }}
  {{- if .Values.xwiki.enabled }}
  - name: xwiki-postgresql
    username: xwiki
    database: xwiki
    password: {{ dig "postgresql" "password" "xwiki" .Values.xwiki | quote }}
    size: 8Gi
    memoryRequest: 256Mi
    memoryLimit: 1Gi
  {{- end }}

nextcloud:
  gitSourceBranch: {{ .Values.nextcloud.gitSourceBranch | quote }}
  enableApps:
  {{ toYaml .Values.nextcloud.enableApps | nindent 4 }}

openproject:
  dockerTag: {{ .Values.openproject.version | quote }}
  gitSourceBranch: {{ .Values.openproject.gitSourceBranch | quote }}
  localSourcePath: {{ .Values.openproject.localSourcePath | quote }}
  customSourceMountPath: {{ .Values.openproject.customSourceMountPath | quote }}
  standalone: {{ $standalone }}
  enableTestSetup: {{ .Values.openproject.enableTestSetup | default false }}
  railsEnv: {{ .Values.openproject.railsEnv | quote }}
  xwiki:
    clientId: {{ $openprojectXwiki.clientId | default "xwiki-client-id" | quote }}
    clientSecret: {{ $openprojectXwiki.clientSecret | default "xwiki-client-secret" | quote }}

{{- if not (.Values.previewMode | default false) }}
extraVolumes:
  - name: ca-cert
    secret:
      secretName: {{ or .Values.ingress.existingTlsSecretName .Values.ingress.tlsSecretName }}

extraVolumeMounts:
  - name: ca-cert
    mountPath: {{ .Values.ingress.caCertFileMountPath }}
    subPath: ca.crt

extraEnv:
  - name: CURL_CA_BUNDLE
    value: {{ .Values.ingress.caCertFileMountPath }}
  - name: SSL_CERT_FILE
    value: {{ .Values.ingress.caCertFileMountPath }}
{{- end }}

oidcProvider:
  name: {{ .Values.keycloak.providerName }}
  openprojectClientId: {{ ternary .Values.integration.oidcClients.openprojectNC.id .Values.integration.oidcClients.openprojectKC.id (eq .Values.integration.setupMethod "sso-nextcloud") | quote }}
  openprojectClientSecret: {{ ternary .Values.integration.oidcClients.openprojectNC.secret .Values.integration.oidcClients.openprojectKC.secret (eq .Values.integration.setupMethod "sso-nextcloud") | quote }}
  nextcloudClientSecret: {{ .Values.integration.oidcClients.nextcloud.secret | quote }}

ingress:
  ingressClassName: {{ .Values.ingress.ingressClassName }}
  tlsSecretName: {{ .Values.ingress.tlsSecretName }}
  existingTlsSecretName: {{ .Values.ingress.existingTlsSecretName }}

persistence:
  storageClassName: {{ .Values.persistence.storageClassName | quote }}
  accessModes:
    - {{ .Values.persistence.accessMode | quote }}

xwiki:
  enabled: {{ .Values.xwiki.enabled }}

gitlab:
  enabled: {{ .Values.gitlab.enabled }}
  initialRootPassword: {{ .Values.gitlab.initialRootPassword | quote }}
  postgresql:
    password: {{ .Values.gitlab.postgresql.password | quote }}
  redis:
    password: {{ .Values.gitlab.redis.password | quote }}

squashtm:
  enabled: {{ .Values.squashtm.enabled }}
