gitlab:
  global:
    hosts:
      domain: {{ .Values.gitlab.host }}
      https: false
    initialRootPassword:
      secret: gitlab-root-password
      key: password
    redis:
      host: gitlab-redis-master
      auth:
        secret: gitlab-redis-password
        key: password
    psql:
      host: gitlab-postgresql
      username: gitlab
      database: gitlab
      password:
        secret: gitlab-psql-password
        key: password
    image:
      tag: {{ .Values.gitlab.version }}
  gitlab:
    webservice:
      image:
        tag: {{ .Values.gitlab.version }}
    gitlab-shell:
      image:
        tag: {{ .Values.gitlab.version }}
    sidekiq:
      image:
        tag: {{ .Values.gitlab.version }}
    gitaly:
      image:
        tag: {{ .Values.gitlab.version }}
    migrations:
      image:
        tag: {{ .Values.gitlab.version }}
