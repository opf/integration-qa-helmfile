fullnameOverride: {{ .Values.keycloak.fullnameOverride }}
auth:
  adminUser: admin
hostname: {{ .Values.keycloak.host | quote }}
realm:
  name: {{ .Values.keycloak.realm.name | quote }}
postgresql:
  host: {{ dig "postgresql" "host" "kc-postgresql" .Values.keycloak | quote }}
  username: keycloak
  database: keycloak
clients:
  nextcloud:
    id: {{ .Values.integration.oidcClients.nextcloud.id | quote }}
    host: {{ .Values.nextcloud.host | quote }}
  openproject:
    id: {{ ternary .Values.integration.oidcClients.openprojectNC.id .Values.integration.oidcClients.openprojectKC.id (eq .Values.integration.setupMethod "sso-nextcloud") | quote }}
    host: {{ .Values.openproject.host | quote }}
