fullnameOverride: xwiki
image:
  tag: {{ .Values.xwiki.version | default "latest" | quote }}
probes:
  startup:
    enabled: true
    exec:
      command:
        - /bin/sh
        - -c
        - "test -f /xwiki-ready"
    httpGet:
      enabled: false
    initialDelaySeconds: 300
    timeoutSeconds: 10
    periodSeconds: 30
    failureThreshold: 120
    successThreshold: 1
  liveness:
    enabled: false
  readiness:
    enabled: true
    initialDelaySeconds: 120
    timeoutSeconds: 10
    periodSeconds: 30
    failureThreshold: 40
    successThreshold: 1
    httpGet:
      enabled: true
      path: /rest/openproject/metadata
customConfigs:
  xwiki.properties:
    distribution.job.interactive: false
    distribution.job.interactive.wiki: false
    distribution.defaultUI: "org.xwiki.platform:xwiki-platform-distribution-flavor-mainwiki"
customConfigsSecrets:
  xwiki.cfg:
    xwiki.superadminpassword:
      value: admin
extraEnvVars:
  - name: EXTENSION_OPENPROJECT_VERSION
    value: {{ .Values.xwiki.extensions.openproject.version | default "1.2.0" | quote }}
  - name: OPENPROJECT_HOST
    value: https://{{ .Values.openproject.host }}
  - name: OPENPROJECT_CLIENT_ID
    value: {{ .Values.openproject.xwiki.clientId | quote }}
  - name: OPENPROJECT_CLIENT_SECRET
    value: {{ .Values.openproject.xwiki.clientSecret | quote }}
  {{- if not (.Values.previewMode | default false) }}
  - name: CURL_CA_BUNDLE
    value: {{ .Values.ingress.caCertFileMountPath }}
  - name: SSL_CERT_FILE
    value: {{ .Values.ingress.caCertFileMountPath }}
  {{- end }}
extraVolumes:
  - name: xwiki-entrypoint
    configMap:
      name: xwiki-entrypoint-configmap
      defaultMode: 0755
  {{- if not (.Values.previewMode | default false) }}
  - name: ca-cert
    secret:
      secretName: {{ or .Values.ingress.tlsSecretName .Values.ingress.existingTlsSecretName }}
  {{- end }}
extraVolumeMounts:
  - name: xwiki-entrypoint
    mountPath: /entrypoint.sh
    subPath: entrypoint.sh
  {{- if not (.Values.previewMode | default false) }}
  - name: ca-cert
    mountPath: {{ .Values.ingress.caCertFileMountPath }}
    subPath: ca.crt
  {{- end }}
mysql:
  enabled: true
  primary:
    startupProbe:
      enabled: true
      initialDelaySeconds: 30
      timeoutSeconds: 5
      periodSeconds: 10
      failureThreshold: 60
      successThreshold: 1
