{{- $publicDns := requiredEnv "PULLPREVIEW_PUBLIC_DNS" -}}
{{- $setupMethod := env "INTEGRATION_SETUP_METHOD" | default "sso-external" -}}
{{- $opVersion := env "OPENPROJECT_VERSION" | default "17" -}}
{{- $opBranch := env "OPENPROJECT_BRANCH" -}}
{{- $ncVersion := env "NEXTCLOUD_VERSION" | default "34" -}}
{{- $ncBranch := env "NEXTCLOUD_BRANCH" -}}
{{- $kcVersion := env "KEYCLOAK_VERSION" | default "26.2.5" -}}
{{- $ioVersion := env "INTEGRATION_OPENPROJECT_VERSION" -}}
{{- $ioBranch := env "INTEGRATION_OPENPROJECT_GIT_BRANCH" -}}
{{- $xwikiVersion := env "XWIKI_VERSION" | default "17.10.15" -}}
{{- $xwikiExtVersion := env "XWIKI_EXTENSION_OPENPROJECT_VERSION" | default "1.2.0" -}}
{{- $wikiEnhancements := env "OPENPROJECT_FEATURE_WIKI_ENHANCEMENTS" | default "true" -}}
{{- $xwikiEnabled := env "XWIKI_ENABLED" | default "true" -}}
{{- $gitlabEnabled := env "GITLAB_ENABLED" | default "false" -}}
{{- $gitlabVersion := env "GITLAB_VERSION" | default "v19.4.1" -}}
{{- $squashtmEnabled := env "SQUASHTM_ENABLED" | default "false" -}}
{{- $squashtmVersion := env "SQUASHTM_VERSION" | default "" -}}
{{- $adminPassword := requiredEnv "PULLPREVIEW_ADMIN_PASSWORD" -}}
{{- $userPassword := requiredEnv "PULLPREVIEW_USER_PASSWORD" -}}
{{- $mcpToken := requiredEnv "PULLPREVIEW_MCP_TOKEN" -}}
{{- $opDbPassword := requiredEnv "PULLPREVIEW_OP_DB_PASSWORD" -}}
{{- $ncDbPassword := requiredEnv "PULLPREVIEW_NC_DB_PASSWORD" -}}
{{- $gitlabDbPassword := requiredEnv "PULLPREVIEW_GITLAB_DB_PASSWORD" -}}
{{- $gitlabRedisPassword := requiredEnv "PULLPREVIEW_GITLAB_REDIS_PASSWORD" -}}
{{- $ncOidcSecret := requiredEnv "PULLPREVIEW_NC_OIDC_SECRET" -}}
{{- $opNcOidcSecret := requiredEnv "PULLPREVIEW_OP_NC_OIDC_SECRET" -}}
{{- $opKcOidcSecret := requiredEnv "PULLPREVIEW_OP_KC_OIDC_SECRET" -}}
{{- $xwikiOauthSecret := requiredEnv "PULLPREVIEW_XWIKI_OAUTH_SECRET" -}}
{{- $xwikiDbPassword := requiredEnv "PULLPREVIEW_XWIKI_DB_PASSWORD" -}}
{{- $kcDbPassword := requiredEnv "PULLPREVIEW_KC_DB_PASSWORD" -}}

{{- $profile := env "STACK_PROFILE" | default "full" -}}
{{- $standalone := ne $profile "full" -}}
{{- $keycloakEnabled := or (eq $profile "full") (eq $profile "op-keycloak") -}}
previewMode: true

adminPassword: {{ $adminPassword | quote }}
userPassword: {{ $userPassword | quote }}

mcp:
  enabled: true
  oauthToken: {{ $mcpToken | quote }}

integration:
  setupMethod: {{ $setupMethod | quote }}
  oidcClients:
    nextcloud:
      id: nextcloud
      secret: {{ $ncOidcSecret | quote }}
    openprojectNC:
      id: 4xMOWGYBXhSMNBcSwpgPW1B3Q7TPuP3S
      secret: {{ $opNcOidcSecret | quote }}
    openprojectKC:
      id: openproject
      secret: {{ $opKcOidcSecret | quote }}

openproject:
  fullnameOverride: openproject
  host: {{ $publicDns | quote }}
  assetHost: {{ printf "openproject-assets.%s" $publicDns | quote }}
  standalone: {{ $standalone }}
  version: {{ $opVersion | quote }}
  gitSourceBranch: {{ $opBranch | quote }}
  localSourcePath: ''
  customSourceMountPath: /home/app/openproject
  sourcePvcStorage: 12Gi
  enableTestSetup: false
  railsEnv: production
  enterpriseToken: |
{{ requiredEnv "OPENPROJECT_ENTERPRISE_TOKEN" | nindent 4 }}
  postgresql:
    host: op-postgresql
    database: openproject
    username: openproject
    password: {{ $opDbPassword | quote }}
  xwiki:
    clientId: xwiki-client-id
    clientSecret: {{ $xwikiOauthSecret | quote }}
  features:
    wikiEnhancements: {{ eq $wikiEnhancements "true" }}

nextcloud:
  version: {{ $ncVersion | quote }}
  gitSourceBranch: {{ $ncBranch | quote }}
  fullnameOverride: nextcloud
  host: {{ printf "nextcloud.%s" $publicDns | quote }}
  enableApps:
    - name: integration_openproject
      version: {{ $ioVersion | quote }}
      gitBranch: {{ $ioBranch | quote }}
    - name: oidc
      version: ''
      gitBranch: ''
    - name: user_oidc
      version: ''
      gitBranch: ''
    - name: groupfolders
      version: ''
      gitBranch: ''
  postgresql:
    host: nc-postgresql
    database: nextcloud
    username: nextcloud
    password: {{ $ncDbPassword | quote }}

keycloak:
  enabled: {{ $keycloakEnabled }}
  version: {{ $kcVersion | quote }}
  fullnameOverride: keycloak
  host: {{ printf "keycloak.%s" $publicDns | quote }}
  providerName: keycloak
  realm:
    name: opnc
  postgresql:
    host: kc-postgresql
    password: {{ $kcDbPassword | quote }}

ingress:
  ingressClassName: traefik
  tlsSecretName: ''
  existingTlsSecretName: ''
  caCertFileMountPath: /certs/ca.crt

persistence:
  storageClassName: local-path
  accessMode: ReadWriteOnce

xwiki:
  enabled: {{ eq $xwikiEnabled "true" }}
  host: {{ printf "xwiki.%s" $publicDns | quote }}
  version: {{ $xwikiVersion | quote }}
  postgresql:
    password: {{ $xwikiDbPassword | quote }}
  extensions:
    openproject:
      version: {{ $xwikiExtVersion | quote }}

gitlab:
  enabled: {{ eq $gitlabEnabled "true" }}
  host: {{ printf "gitlab.%s" $publicDns | quote }}
  version: {{ $gitlabVersion | quote }}
  initialRootPassword: {{ $adminPassword | quote }}
  postgresql:
    password: {{ $gitlabDbPassword | quote }}
  redis:
    password: {{ $gitlabRedisPassword | quote }}

squashtm:
  enabled: {{ eq $squashtmEnabled "true" }}
  host: {{ printf "squashtm.%s" $publicDns | quote }}
  version: {{ $squashtmVersion | quote }}
  {{- if eq $squashtmEnabled "true" }}
  adminPassword: {{ requiredEnv "SQUASHTM_ADMIN_PASSWORD" | quote }}
  {{- else }}
  adminPassword: ''
  {{- end }}

