{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "strict": true,
    "types": [
      "node",
      "@playwright/test"
    ],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "tests/**/*",
    "pageobjects/**/*",
    "scripts/**/*",
    "utils/**/*",
    "playwright.config.ts",
    "global-setup.ts"
  ]
}
