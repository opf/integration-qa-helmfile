{
  "url": "https://keycloak.test",
  "selectors": {
    "usernameInput": {
      "by": "getByLabel",
      "value": "Username or email"
    },
    "passwordInput": {
      "by": "locator",
      "value": "input[type='password']#password"
    },
    "loginButton": {
      "by": "getByRole",
      "value": {
        "role": "button",
        "name": "Sign In"
      }
    },
    "signInText": {
      "by": "getByText",
      "value": "Sign in to your account"
    },
    "adminConsole": {
      "by": "locator",
      "value": "#kc-page-title:has-text('Welcome to Keycloak')"
    },
    "welcomeText": {
      "by": "getByText",
      "value": "Welcome to Keycloak"
    },
    "realmSelector": {
      "by": "locator",
      "value": "#realm-select"
    },
    "manageRealmsButton": {
      "by": "getByTestId",
      "value": "nav-item-realms"
    },
    "manageRealmsText": {
      "by": "getByText",
      "value": "Manage realms"
    },
    "realmLink": {
      "by": "locator",
      "value": "a[href^='#/']"
    },
    "opncRealmLink": {
      "by": "locator",
      "value": "a[href='#/opnc']"
    },
    "currentRealm": {
      "by": "getByTestId",
      "value": "currentRealm"
    },
    "clientsButton": {
      "by": "getByTestId",
      "value": "nav-item-clients"
    },
    "nextcloudClientLink": {
      "by": "getByRole",
      "value": { "role": "link", "name": "nextcloud", "options": { "exact": true } }
    },
    "openprojectClientLink": {
      "by": "getByRole",
      "value": { "role": "link", "name": "openproject", "options": { "exact": true } }
    }
  }
}

