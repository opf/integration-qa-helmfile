{
  "url": "https://nextcloud.test",
  "selectors": {
    "usernameInput": {
      "by": "locator",
      "value": "#user"
    },
    "passwordInput": {
      "by": "locator",
      "value": "#password"
    },
    "loginButton": {
      "by": "locator",
      "value": "button[data-login-form-submit][type='submit']"
    },
    "welcomeMessageClose": {
      "by": "locator",
      "value": ".welcome .close, .modal__close, [aria-label*='close'], [aria-label*='Close']"
    },
    "welcomeDialog": {
      "by": "getByRole",
      "value": {
        "role": "dialog",
        "name": "Welcome to Nextcloud!",
        "options": {
          "exact": false
        }
      }
    },
    "firstRunWizard": {
      "by": "locator",
      "value": "#firstrunwizard.first-run-wizard[role='dialog'], .first-run-wizard[role='dialog']"
    },
    "firstRunWizardDialog": {
      "by": "locator",
      "value": "#firstrunwizard.first-run-wizard[role='dialog'], .first-run-wizard[role='dialog']"
    },
    "firstRunWizardIntroVideo": {
      "by": "locator",
      "value": ".first-run-wizard[role='dialog'] video[poster*='nextcloudHub'], .first-run-wizard[role='dialog'] video:has(source[src*='nextcloudHub'])"
    },
    "firstRunWizardSkipButton": {
      "by": "locator",
      "value": ".first-run-wizard[role='dialog'] button:has-text('Skip'), .first-run-wizard[role='dialog'] button[class*='introAnimation__skipButton']"
    },
    "firstRunWizardCloseButton": {
      "by": "locator",
      "value": ".first-run-wizard[role='dialog'] button[aria-label='Close']"
    },
    "profileIcon": {
      "by": "locator",
      "value": "button[aria-label='Settings menu']"
    },
    "administrationSettingsLink": {
      "by": "locator",
      "value": "a#admin_settings[href*='/settings/admin/overview']"
    },
    "openIdConnectLink": {
      "by": "locator",
      "value": "li[data-section-id='user_oidc'] a[href*='/settings/admin/user_oidc']"
    },
    "keycloakProviderDetails": {
      "by": "locator",
      "value": ".oidcproviders__details"
    },
    "keycloakProviderName": {
      "by": "locator",
      "value": ".oidcproviders__details h3:has-text('keycloak')"
    },
    "keycloakClientId": {
      "by": "locator",
      "value": ".oidcproviders__details label:has-text('Client ID') + span"
    },
    "keycloakDiscoveryEndpoint": {
      "by": "locator",
      "value": ".oidcproviders__details label:has-text('Discovery endpoint') + span"
    },
    "keycloakBackchannelLogoutUrl": {
      "by": "locator",
      "value": ".oidcproviders__details label:has-text('Backchannel Logout URL') + span"
    },
    "keycloakRedirectUri": {
      "by": "locator",
      "value": ".oidcproviders__details label:has-text('Redirect URI') + span"
    },
    "userMenu": {
      "by": "locator",
      "value": ".header-menu, [data-user-menu], #user-menu, .avatardiv"
    },
    "integrationAppTitle": {
      "by": "locator",
      "value": "h2:has-text('OpenProject')"
    },
    "integrationAppLink": {
      "by": "getByRole",
      "value": {
        "role": "link",
        "name": "OpenProject"
      }
    },
    "appsMenu": {
      "by": "locator",
      "value": "a#core_apps[href='/settings/apps']"
    },
    "activeAppsLink": {
      "by": "locator",
      "value": "a.app-navigation-entry-link[href='/settings/apps/enabled'][title='Active apps']"
    },
    "appsSettingsContent": {
      "by": "locator",
      "value": "#content.app-settings, #content-vue, #app-content-vue, main#app-content-vue, main"
    },
    "openProjectIntegrationAppRow": {
      "by": "locator",
      "value": "tr:has(a[href*='integration_openproject'])"
    },
    "openProjectIntegrationAppLink": {
      "by": "locator",
      "value": "a[href*='integration_openproject']"
    },
    "openProjectIntegrationAppVersion": {
      "by": "locator",
      "value": "tr:has(a[href*='integration_openproject']) td.app-version span, tr:has(a[href*='integration_openproject']) td:nth-child(2) span"
    },
    "openProjectIntegrationDisableButton": {
      "by": "locator",
      "value": "tr:has(a[href*='integration_openproject']) button:has-text('Disable')"
    },
    "openProjectIntegrationEnableButton": {
      "by": "locator",
      "value": "tr:has(a[href*='integration_openproject']) button:has-text('Enable')"
    },
    "openProjectIntegrationUpdateButton": {
      "by": "locator",
      "value": "tr:has(a[href*='integration_openproject']) button:has-text('Update')"
    },
    "pageBody": {
      "by": "locator",
      "value": "body"
    },
    "openProjectIntegrationActionsButton": {
      "by": "locator",
      "value": "tr:has(a[href*='integration_openproject']) button[aria-label='Actions'], tr:has(a[href*='integration_openproject']) button[aria-label*='Actions']"
    },
    "openProjectIntegrationDisableMenuItem": {
      "by": "getByRole",
      "value": {
        "role": "menuitem",
        "name": "Disable"
      }
    },
    "openProjectIntegrationRemoveMenuItem": {
      "by": "getByRole",
      "value": {
        "role": "menuitem",
        "name": "Remove"
      }
    },
    "openProjectIntegrationRemoveButton": {
      "by": "locator",
      "value": "tr:has(a[href*='integration_openproject']) button:has-text('Remove')"
    },
    "openProjectIntegrationDownloadEnableButton": {
      "by": "locator",
      "value": "tr:has(a[href*='integration_openproject']) button:has-text('Download and enable')"
    },
    "openProjectIntegrationDownloadForceEnableMenuItem": {
      "by": "locator",
      "value": "[role='menuitem']:has-text('Download and force enable')"
    },
    "openProjectIntegrationDownloadEnableMenuItem": {
      "by": "locator",
      "value": "[role='menuitem']:has-text('Download and enable'), [role='menuitem']:has-text('Download and force enable')"
    },
    "integrationsAppsLink": {
      "by": "locator",
      "value": "a.app-navigation-entry-link[href*='/settings/apps/integration']:not([href*='integration_']), a[href*='/settings/apps/integration']:has-text('Integration')"
    },
    "integrationsAppsText": {
      "by": "getByRole",
      "value": {
        "role": "heading",
        "name": "Integration"
      }
    },
    "disabledAppsLink": {
      "by": "locator",
      "value": "a.app-navigation-entry-link[href='/settings/apps/disabled'][title='Disabled apps'], a.app-navigation-entry-link[href*='/settings/apps/disabled']"
    },
    "disabledAppsText": {
      "by": "getByRole",
      "value": {
        "role": "heading",
        "name": "Disabled apps"
      }
    },
    "appsSearchInput": {
      "by": "getByRole",
      "value": {
        "role": "searchbox",
        "name": "Search apps…"
      }
    },
    "passwordConfirmDialog": {
      "by": "getByRole",
      "value": {
        "role": "dialog",
        "name": "Authentication required"
      }
    },
    "passwordConfirmInput": {
      "by": "locator",
      "value": "[role='dialog'] input[type='password']"
    },
    "passwordConfirmButton": {
      "by": "locator",
      "value": "[role='dialog'] button:has-text('Confirm')"
    },
    "loginText": {
      "by": "getByText",
      "value": "Log in to Nextcloud"
    },
    "loginForm": {
      "by": "locator",
      "value": "#user, input[name='user']"
    },
    "closeButton": {
      "by": "locator",
      "value": "button[aria-label='Close']"
    },
    "registeredProvidersText": {
      "by": "getByText",
      "value": "Registered Providers"
    },
    "discoverText": {
      "by": "locator",
      "value": "h2.app-settings-content__label:has-text('Discover')"
    },
    "activeAppsText": {
      "by": "getByRole",
      "value": {
        "role": "heading",
        "name": "Active apps"
      }
    },
    "integrationAppTitleAlt": {
      "by": "locator",
      "value": "h2:has-text('OpenProject'), h1:has-text('OpenProject'), [data-app='integration_openproject']"
    },
    "ncPersonalSettingsOpenProjectSection": {
      "by": "locator",
      "value": ".openproject-prefs, .openproject-prefs--content"
    },
    "ncPersonalSettingsConnectedLabel": {
      "by": "locator",
      "value": ".openproject-prefs--connected label"
    },
    "ncPersonalSettingsDisconnectButton": {
      "by": "getByRole",
      "value": {
        "role": "button",
        "name": "Disconnect from OpenProject"
      }
    },
    "ncPersonalSettingsConnectButton": {
      "by": "getByRole",
      "value": {
        "role": "button",
        "name": "Connect to OpenProject"
      }
    },
    "ncPersonalSettingsDisconnectSuccessMessage": {
      "by": "getByText",
      "value": "OpenProject options saved"
    },
    "ncPersonalSettingsConnectSuccessMessage": {
      "by": "getByText",
      "value": "Successfully connected to OpenProject!"
    }
  }
}
